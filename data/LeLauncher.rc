#include <winresrc.h>
#include "core/Version.h"

#ifndef VOS_NT_WINDOWS32
#define VOS_NT_WINDOWS32 0x00040004L
#endif

#ifndef VFT_APP
#define VFT_APP 0x00000001L
#endif

#ifndef VFT2_UNKNOWN
#define VFT2_UNKNOWN 0x00000000L
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     RC_FILEVERSION
PRODUCTVERSION  RC_PRODUCTVERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      RC_COMPANY_NAME "\0"
            VALUE "FileDescription",  RC_FILEDESCRIPTION "\0"
            VALUE "FileVersion",      RC_FILEVERSION_STRING "\0"
            VALUE "InternalName",     RC_INTERNAL_NAME "\0"
            VALUE "LegalCopyright",   RC_LEGAL_COPYRIGHT "\0"
            VALUE "OriginalFilename", RC_ORIGINAL_FILENAME "\0"
            VALUE "ProductName",      RC_PRODUCT_NAME "\0"
            VALUE "ProductVersion",   RC_PRODUCTVERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
