using Gtk 4.0;

ApplicationWindow app_window {
  title: "LeLauncher";
  default-width: 760;
  default-height: 560;

  [titlebar]
  HeaderBar {
    [title]
    Label {
      label: "LeLauncher - Game Client";
      styles ["title"]
    }

    [end]
    Button refresh_btn {
      icon-name: "view-refresh-symbolic";
      tooltip-text: "Refresh Server Status and Account";
    }
  }

  Box {
    orientation: vertical;
    spacing: 16;
    margin-top: 20;
    margin-bottom: 20;
    margin-start: 24;
    margin-end: 24;

    Box {
      orientation: horizontal;
      spacing: 18;
      styles ["card"]

      Box {
        orientation: vertical;
        spacing: 4;
        hexpand: true;

        Label realm_name_label {
          label: "Realm: Azeroth Prime";
          halign: start;
          styles ["title-3"]
        }

        Label motd_label {
          label: "Connecting to live server socket...";
          halign: start;
          styles ["dim-label"]
        }
      }

      Box {
        orientation: horizontal;
        spacing: 16;
        valign: center;

        Label online_players_label {
          label: "Online: --";
          styles ["accent"]
        }

        Label ingame_players_label {
          label: "In-Game: --";
          styles ["success"]
        }

        Label ping_label {
          label: "Ping: -- ms";
          styles ["dim-label"]
        }
      }
    }

    Box {
      orientation: vertical;
      spacing: 12;
      styles ["card"]

      Label {
        label: "Account Verification (AzerothCore Auth)";
        halign: start;
        styles ["heading"]
      }

      Label client_info_label {
        label: "Detecting Hardware ID and Network IP...";
        halign: start;
        styles ["caption"]
      }

      Box {
        orientation: horizontal;
        spacing: 12;

        Entry server_entry {
          placeholder-text: "API Endpoint (e.g. http://localhost:8080 or leave blank for default)";
          hexpand: true;
        }
      }

      Box {
        orientation: horizontal;
        spacing: 12;

        Entry username_entry {
          placeholder-text: "Username...";
          hexpand: true;
        }

        PasswordEntry password_entry {
          placeholder-text: "Password...";
          show-peek-icon: true;
          hexpand: true;
        }

        Button verify_btn {
          label: "Verify Account";
          styles ["suggested-action", "pill"]
        }

        Button save_btn {
          label: "Save";
        }
      }

      Label auth_status_label {
        label: "Ready for verification";
        halign: start;
        styles ["dim-label"]
      }
    }

    Box {
      orientation: vertical;
      spacing: 12;
      styles ["card"]

      Box {
        orientation: horizontal;
        spacing: 12;

        Box {
          orientation: vertical;
          spacing: 2;
          hexpand: true;

          Label patch_title_label {
            label: "Game Client & Content Patcher (.mfil)";
            halign: start;
            styles ["heading"]
          }

          Label patch_status_label {
            label: "Ready to check for updates (Blizzard .mfil engine)";
            halign: start;
            styles ["caption"]
          }
        }

        Button update_btn {
          label: "Update Game";
          styles ["suggested-action", "pill"]
        }

        Button play_btn {
          label: "Play Game";
          sensitive: false;
          styles ["success", "pill"]
        }
      }

      ProgressBar download_progress {
        fraction: 0.0;
        show-text: true;
        text: "Idle";
      }

      Box {
        orientation: horizontal;
        spacing: 16;

        Label download_speed_label {
          label: "-- KB/s";
          halign: start;
          styles ["dim-label"]
        }

        Label download_eta_label {
          label: "ETA: --:--";
          halign: start;
          styles ["dim-label"]
        }

        Label download_file_label {
          label: "";
          halign: end;
          hexpand: true;
          styles ["dim-label"]
        }
      }
    }

    Label {
      label: "Activity and Live Feed";
      halign: start;
      styles ["heading"]
    }

    ScrolledWindow {
      vexpand: true;
      hexpand: true;
      min-content-height: 180;
      styles ["card"]

      TextView log_view {
        editable: false;
        cursor-visible: false;
        monospace: true;
        left-margin: 12;
        right-margin: 12;
        top-margin: 12;
        bottom-margin: 12;
      }
    }
  }
}
